{
  "name": "aurora-theatre-hk",
  "private": true,
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs && node scripts/build-galleries.mjs && node scripts/build-services.mjs",
    "build:blog": "node scripts/build-blog.mjs",
    "build:css": "tailwindcss -i ./css/input.css -o ./public/css/style.css --minify",
    "build:sitemap": "SITE_URL=https://www.auroratheatrehk.com node scripts/generate-sitemap.js ./public",
    "build:security-txt": "SITE_URL=https://www.auroratheatrehk.com SECURITY_CONTACT=mailto:security@gocloud.consulting node scripts/generate-security-txt.js ./public",
    "build": "npm run build:pages && npm run build:blog && npm run build:css && npm run build:sitemap && npm run build:security-txt",
    "dev": "tailwindcss -i ./css/input.css -o ./public/css/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.114.0"
  }
}
