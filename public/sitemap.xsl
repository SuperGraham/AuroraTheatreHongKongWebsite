<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xsl

  Purely cosmetic — makes no difference to search engines at all, which
  parse the raw XML directly and ignore this file entirely. This only
  changes what a human sees if they open sitemap.xml directly in a
  browser: a styled, readable page instead of the browser's generic
  raw-XML tree view. scripts/generate-sitemap.js writes the matching
  <?xml-stylesheet?> processing instruction at the top of sitemap.xml —
  copying this file, sitemap.css, and js/sitemap-sort.js into public/ is
  the only manual step, since none of them need per-project customization.

  Deliberately references external sitemap.css / js/sitemap-sort.js
  rather than embedding a <style>/<script> block inline — the site's own
  CSP (style-src 'self', script-src 'self', neither with 'unsafe-inline')
  silently blocks inline style/script blocks, the same reason
  content/pages/contact.mjs's honeypot field uses a CSS class instead of
  an inline style. An earlier version of this file embedded both inline
  and shipped looking completely unstyled in production as a result — not
  a design problem, a CSP one; none of that CSS or JS was ever executing.
  See sitemap.css's own comment for how the priority bars specifically
  work around this (discrete preset width classes instead of a computed
  inline style="width: X%", since that's also blocked and can't just
  become one static external class the way everything else could).

  XSLT 1.0 only (not 2.0/3.0) — that's the only version browsers actually
  implement natively for this mechanism.
-->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Sitemap — <xsl:value-of select="count(sitemap:urlset/sitemap:url)"/> URLs</title>
<link rel="stylesheet" href="/sitemap.css"/>
</head>
<body>
<div class="wrap">
  <header>
    <p class="eyebrow">XML Sitemap</p>
    <h1><xsl:value-of select="count(sitemap:urlset/sitemap:url)"/> URLs</h1>
    <p class="sub">This is a human-readable view of <code>sitemap.xml</code> — search engines read the raw XML directly and never see this styling.</p>
  </header>
  <div class="card">
    <table id="sitemap-table">
      <thead>
        <tr>
          <th data-sort="url">URL <span class="arrow">↕</span></th>
          <th data-sort="lastmod">Last modified <span class="arrow">↕</span></th>
          <th data-sort="changefreq">Change frequency <span class="arrow">↕</span></th>
          <th data-sort="priority">Priority <span class="arrow">↕</span></th>
        </tr>
      </thead>
      <tbody>
        <xsl:for-each select="sitemap:urlset/sitemap:url">
        <xsl:sort select="sitemap:priority" order="descending"/>
        <tr data-url="{sitemap:loc}" data-lastmod="{sitemap:lastmod}" data-changefreq="{sitemap:changefreq}" data-priority="{sitemap:priority}">
          <td class="url"><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
          <td class="lastmod"><xsl:value-of select="sitemap:lastmod"/></td>
          <td><xsl:if test="sitemap:changefreq"><span class="badge"><xsl:value-of select="sitemap:changefreq"/></span></xsl:if></td>
          <td>
            <xsl:if test="sitemap:priority">
              <div class="priority-cell">
                <div class="priority-track">
                  <div class="priority-fill priority-{round(sitemap:priority * 10) * 10}"></div>
                </div>
                <span class="priority-value"><xsl:value-of select="sitemap:priority"/></span>
              </div>
            </xsl:if>
          </td>
        </tr>
        </xsl:for-each>
      </tbody>
    </table>
  </div>
  <footer>Generated by sitemap.xml — sorted by priority by default, click any column to re-sort.</footer>
</div>
<script src="/js/sitemap-sort.js"></script>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
